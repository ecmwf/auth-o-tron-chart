{
 "title": "Auth-O-Tron",
 "uid": "auth-o-tron",
 "tags": [
  "auth-o-tron",
  "ecmwf"
 ],
 "schemaVersion": 39,
 "version": 1,
 "editable": false,
 "graphTooltip": 1,
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "refresh": "30s",
 "timezone": "",
 "annotations": {
  "list": [
   {
    "builtIn": 1,
    "datasource": {
     "type": "grafana",
     "uid": "-- Grafana --"
    },
    "enable": true,
    "hide": true,
    "iconColor": "rgba(0, 211, 255, 1)",
    "name": "Annotations & Alerts",
    "type": "dashboard"
   },
   {
    "name": "Deploys",
    "datasource": {
     "type": "prometheus",
     "uid": "${datasource}"
    },
    "enable": true,
    "iconColor": "rgba(255, 96, 96, 1)",
    "expr": "max by (namespace, job, version) (authotron_build_info{namespace=~\"$namespace\",job=~\"$job\"}) unless max by (namespace, job, version) (authotron_build_info{namespace=~\"$namespace\",job=~\"$job\"} offset 1m)",
    "titleFormat": "Deploy {{namespace}}/{{job}} {{version}}",
    "step": "1m"
   }
  ]
 },
 "templating": {
  "list": [
   {
    "name": "datasource",
    "label": "Data source",
    "type": "datasource",
    "query": "prometheus",
    "current": {},
    "hide": 0,
    "refresh": 1,
    "options": [],
    "regex": ""
   },
   {
    "name": "namespace",
    "label": "Namespace",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "${datasource}"
    },
    "query": "label_values(authotron_build_info, namespace)",
    "refresh": 2,
    "multi": true,
    "includeAll": true,
    "allValue": ".+",
    "sort": 1,
    "current": {}
   },
   {
    "name": "job",
    "label": "Job",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "${datasource}"
    },
    "query": "label_values(authotron_build_info{namespace=~\"$namespace\"}, job)",
    "refresh": 2,
    "multi": true,
    "includeAll": true,
    "allValue": ".+",
    "sort": 1,
    "current": {}
   }
  ]
 },
 "panels": [
  {
   "type": "row",
   "title": "Overview",
   "id": 1,
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "panels": []
  },
  {
   "type": "stat",
   "title": "Scrape targets up",
   "id": 2,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 0,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "textMode": "auto",
    "colorMode": "value",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum(up{namespace=~\"$namespace\",job=~\"$job\"})",
     "legendFormat": "",
     "range": true
    }
   ],
   "description": "Pods being scraped. 0 means metrics are dark, not necessarily the service."
  },
  {
   "type": "stat",
   "title": "Pods by version",
   "id": 3,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 4,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "textMode": "auto",
    "colorMode": "value",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "count by (version) (authotron_build_info{namespace=~\"$namespace\",job=~\"$job\"})",
     "legendFormat": "{{version}}",
     "range": true
    }
   ],
   "description": "Distinct running build versions. >1 means a rollout is mid-flight or stuck."
  },
  {
   "type": "stat",
   "title": "Auth request rate",
   "id": 4,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 8,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "options": {
    "textMode": "auto",
    "colorMode": "value",
    "graphMode": "area",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum(rate({__name__=~\"authotron_auth_requests_total|auth_requests_total\",namespace=~\"$namespace\",job=~\"$job\"}[$__rate_interval]))",
     "legendFormat": "",
     "range": true
    }
   ],
   "description": "Total authentication attempts per second across all realms."
  },
  {
   "type": "stat",
   "title": "Auth failure ratio",
   "id": 5,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 12,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "yellow",
        "value": 0.1
       },
       {
        "color": "red",
        "value": 0.5
       }
      ]
     },
     "decimals": 2
    },
    "overrides": []
   },
   "options": {
    "textMode": "auto",
    "colorMode": "value",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum(rate({__name__=~\"authotron_auth_requests_total|auth_requests_total\",namespace=~\"$namespace\",job=~\"$job\",result!=\"success\"}[$__rate_interval])) / clamp_min(sum(rate({__name__=~\"authotron_auth_requests_total|auth_requests_total\",namespace=~\"$namespace\",job=~\"$job\"}[$__rate_interval])), 1e-9)",
     "legendFormat": "",
     "range": true
    }
   ],
   "description": "Share of auth attempts that did not succeed (all_failed, invalid_header, no_auth_header)."
  },
  {
   "type": "stat",
   "title": "Auth p99 latency",
   "id": 6,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 16,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "yellow",
        "value": 0.25
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     },
     "decimals": 3
    },
    "overrides": []
   },
   "options": {
    "textMode": "auto",
    "colorMode": "value",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "histogram_quantile(0.99, sum by (le) (rate({__name__=~\"authotron_auth_duration_seconds_bucket|auth_duration_seconds_bucket\",namespace=~\"$namespace\",job=~\"$job\"}[$__rate_interval])))",
     "legendFormat": "",
     "range": true
    }
   ],
   "description": "99th percentile end-to-end authentication latency across realms."
  },
  {
   "type": "stat",
   "title": "Provider error rate",
   "id": 7,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 20,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "yellow",
        "value": 0.01
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "textMode": "auto",
    "colorMode": "value",
    "graphMode": "area",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum(rate({__name__=~\"authotron_auth_provider_attempts_total|auth_provider_attempts_total\",namespace=~\"$namespace\",job=~\"$job\",result=\"error\"}[$__rate_interval]))",
     "legendFormat": "",
     "range": true
    }
   ],
   "description": "Provider-level hard errors per second (upstream/provider failures, not credential rejections)."
  },
  {
   "type": "row",
   "title": "Authentication (RED)",
   "id": 8,
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 5
   },
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "Auth rate by result",
   "id": 9,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 6
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 10,
      "showPoints": "never",
      "spanNulls": false,
      "stacking": {
       "mode": "normal",
       "group": "A"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum by (result) (rate({__name__=~\"authotron_auth_requests_total|auth_requests_total\",namespace=~\"$namespace\",job=~\"$job\"}[$__rate_interval]))",
     "legendFormat": "{{result}}",
     "range": true
    }
   ],
   "description": "Request throughput split by outcome. success vs all_failed/invalid_header/no_auth_header."
  },
  {
   "type": "timeseries",
   "title": "Auth failure ratio by realm",
   "id": 10,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 8,
    "y": 6
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 0,
      "showPoints": "never",
      "spanNulls": false
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "unknown": {
         "text": "unresolved (pre-auth/failed)",
         "index": 0
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum by (realm) (rate({__name__=~\"authotron_auth_requests_total|auth_requests_total\",namespace=~\"$namespace\",job=~\"$job\",result!=\"success\"}[$__rate_interval])) / clamp_min(sum by (realm) (rate({__name__=~\"authotron_auth_requests_total|auth_requests_total\",namespace=~\"$namespace\",job=~\"$job\"}[$__rate_interval])), 1e-9)",
     "legendFormat": "{{realm}}",
     "range": true
    }
   ],
   "description": "Per-realm error ratio. A configured realm spiking while others stay flat isolates a broken provider/config. The 'unresolved (pre-auth/failed)' series is the synthetic realm=\"unknown\" bucket auth-o-tron records for requests that never resolved to a user (missing/invalid header, all providers rejected) - it is failures by definition, so it sits at 100%."
  },
  {
   "type": "timeseries",
   "title": "Auth latency quantiles",
   "id": 11,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 16,
    "y": 6
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 0,
      "showPoints": "never",
      "spanNulls": false
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "histogram_quantile(0.50, sum by (le) (rate({__name__=~\"authotron_auth_duration_seconds_bucket|auth_duration_seconds_bucket\",namespace=~\"$namespace\",job=~\"$job\"}[$__rate_interval])))",
     "legendFormat": "p50",
     "range": true
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "histogram_quantile(0.90, sum by (le) (rate({__name__=~\"authotron_auth_duration_seconds_bucket|auth_duration_seconds_bucket\",namespace=~\"$namespace\",job=~\"$job\"}[$__rate_interval])))",
     "legendFormat": "p90",
     "range": true
    },
    {
     "refId": "C",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "histogram_quantile(0.99, sum by (le) (rate({__name__=~\"authotron_auth_duration_seconds_bucket|auth_duration_seconds_bucket\",namespace=~\"$namespace\",job=~\"$job\"}[$__rate_interval])))",
     "legendFormat": "p99",
     "range": true
    }
   ],
   "description": "End-to-end auth latency distribution. Divergence between p50 and p99 points to tail latency from a slow provider."
  },
  {
   "type": "timeseries",
   "title": "Auth rate per pod",
   "id": 12,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 14
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 10,
      "showPoints": "never",
      "spanNulls": false
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum by (pod) (rate({__name__=~\"authotron_auth_requests_total|auth_requests_total\",namespace=~\"$namespace\",job=~\"$job\"}[$__rate_interval]))",
     "legendFormat": "{{pod}}",
     "range": true
    }
   ],
   "description": "Per-pod throughput. Uneven lines mean Service load-balancing is skewed across replicas."
  },
  {
   "type": "timeseries",
   "title": "Auth p99 latency by realm",
   "id": 13,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 8,
    "y": 14
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 0,
      "showPoints": "never",
      "spanNulls": false
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "unknown": {
         "text": "unresolved (pre-auth/failed)",
         "index": 0
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "histogram_quantile(0.99, sum by (le, realm) (rate({__name__=~\"authotron_auth_duration_seconds_bucket|auth_duration_seconds_bucket\",namespace=~\"$namespace\",job=~\"$job\"}[$__rate_interval])))",
     "legendFormat": "{{realm}}",
     "range": true
    }
   ],
   "description": "Tail latency per realm. Isolates which configured realm's provider chain is slow. The 'unresolved (pre-auth/failed)' series is the synthetic realm=\"unknown\" bucket - failed requests still have a measured duration, so the failure path's latency shows up here."
  },
  {
   "type": "timeseries",
   "title": "Auth attempts by result (rate)",
   "id": 14,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 16,
    "y": 14
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 0,
      "showPoints": "never",
      "spanNulls": false
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum by (result) (rate({__name__=~\"authotron_auth_requests_total|auth_requests_total\",namespace=~\"$namespace\",job=~\"$job\"}[$__rate_interval]))",
     "legendFormat": "{{result}}",
     "range": true
    }
   ],
   "description": "Outcome breakdown over time. Rising no_auth_header/invalid_header often means a misconfigured client, not an outage."
  },
